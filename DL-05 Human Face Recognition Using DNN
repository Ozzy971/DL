import numpy as np
import cv2
import matplotlib.pyplot as plt
from tensorflow.keras.layers import Conv2D, UpSampling2D, Input
from tensorflow.keras.models import Sequential
from tensorflow.keras.preprocessing.image import img_to_array, load_img
from skimage.color import rgb2lab, lab2rgb
import os

# Load Dataset

path = "dataset/" # folder with color images
X = []
Y = []
for img_file in os.listdir(path):
 img = load_img(path + img_file, target_size=(256, 256))
 img = img_to_array(img) / 255.0
 lab = rgb2lab(img)
 
 X.append(lab[:,:,0]) # L channel (input)
 Y.append(lab[:,:,1:] / 128) # AB channels (output)
X = np.array(X)
Y = np.array(Y)
# reshape input
X = X.reshape(X.shape[0], 256, 256, 1)

# CNN Model
model = Sequential()
model.add(Input(shape=(256,256,1)))
model.add(Conv2D(64, (3,3), activation='relu', padding='same'))
model.add(Conv2D(64, (3,3), activation='relu', padding='same'))
model.add(Conv2D(128, (3,3), activation='relu', padding='same'))
model.add(Conv2D(128, (3,3), activation='relu', padding='same'))
model.add(UpSampling2D((2,2)))
model.add(Conv2D(64, (3,3), activation='relu', padding='same'))
model.add(Conv2D(32, (3,3), activation='relu', padding='same'))
model.add(Conv2D(2, (3,3), activation='tanh', padding='same'))
model.compile(optimizer='adam', loss='mse')

# Train Model

model.fit(X, Y, batch_size=8, epochs=50)
# Save model
model.save("colorization_model.h5")


#Test on New Image
test_img = load_img("test.jpg", target_size=(256,256))
test_img = img_to_array(test_img) / 255.0
lab = rgb2lab(test_img)
L = lab[:,:,0]
L = L.reshape(1,256,256,1)
# Predict AB channels
pred_ab = model.predict(L)
pred_ab = pred_ab[0] * 128
# Combine L + AB
colorized = np.zeros((256,256,3))
colorized[:,:,0] = L[0][:,:,0]
colorized[:,:,1:] = pred_ab
# Convert LAB → RGB
colorized = lab2rgb(colorized)


plt.figure(figsize=(10,5))
plt.subplot(1,2,1)
plt.title("Grayscale Input")
plt.imshow(L[0][:,:,0], cmap='gray')
plt.subplot(1,2,2)

plt.title("Colorized Output")
plt.imshow(colorized)
plt.show()
